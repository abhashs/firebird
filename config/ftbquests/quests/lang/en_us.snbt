{
	chapter.0000000000000002.title: "Prologue"
	chapter.0000000000000003.title: "Certificate of Minimal Competence"
	chapter.0000000000000004.title: "Notice of Non-Trivial Achievement"
	chapter.0000000000000005.title: "Writ of Industrial Ascendancy"
	chapter.0000000000000006.title: "The Grand Commission"
	chapter.0203B1BB43AA9812.title: "What's Changed"
	chapter_group.3C2B20899292FB72.title: "The Master's Insignia of The Council of the Grand Firebird"
	chapter_group.463BB5E5281C179E.title: "Info"
	quest.0000000000000010.quest_desc: [
		"Somewhere between your third bite of bread and your seventh piece of andesite, a letter materializes."
		""
		"&o\"From the Council of the Grand Firebird\"&r"
		""
		"They have heard of your ambitions but, as the letter clarifies, not yet impressed. They are, however, prepared to offer an opportunity."
		""
		"The letter is stamped seventeen times. You count. You check again. Seventeen."
		""
		""
		"{image:minecolonies:block/books/paper_1 width:100 height:100 align:center}"
	]
	quest.0000000000000010.quest_subtitle: "\"From the Council of the Grand Firebird\""
	quest.0000000000000010.title: "A Letter Arrives"
	quest.0000000000000011.quest_desc: [
		"The Council offers one Master's Insignia per generation."
		""
		"To receive the Master's Insignia of the Council of the Grand Firebird, present the following to the Council's receiving office:"
		""
		"  -> Certificate of Minimal Competence"
		"  -> Notice of Non-Trivial Achievement"
		"  -> Writ of Industrial Ascendancy (Stamped)"
		""
		"The Council does not issue hints. The Council does not accept bribes."
		"The Council does accept very good honey, but this is unrelated to the insignia."
	]
	quest.0000000000000011.quest_subtitle: "The Council Awaits"
	quest.0000000000000011.title: "What Is To Be Done"
	quest.0000000000000020.quest_desc: ["You'll need a lot of it."]
	quest.0000000000000020.quest_subtitle: "Andesite, Andesite, Andesite."
	quest.0000000000000020.title: "What's this?"
	quest.0000000000000021.quest_desc: [
		"The Council recommends harnessing a natural force for your first power source."
		""
		"It's important that it spins, everything will."
	]
	quest.0000000000000021.quest_subtitle: "It'll spin."
	quest.0000000000000021.title: "Reinventing the Wheel"
	quest.0000000000000022.quest_desc: [
		"A mechanical press will help you shape your resources."
		""
		"It does not ask for weekends off."
		"It cares about RPM. Which as we'll see, is somehow worse."
	]
	quest.0000000000000022.quest_subtitle: "The press does not care about your schedule."
	quest.0000000000000022.title: "Under Pressure"
	quest.0000000000000023.quest_desc: ["The crushing wheel will help you process resources at a higher efficiency. And this one won't go flat, hopefully."]
	quest.0000000000000023.quest_subtitle: "This one will be better."
	quest.0000000000000023.title: "Reinventing the Wheel. Again."
	quest.0000000000000024.quest_desc: ["It spins."]
	quest.0000000000000024.quest_subtitle: "Spin it."
	quest.0000000000000024.title: "Not a Fan"
	quest.0000000000000025.quest_desc: [
		"The Council requires its first proof of productivity."
		"They will also be keeping the proof. Just filing purposes."
		""
		"Please ensure materials are processed and not just raw ore from the floor."
		"The Council can, probably, tell."
	]
	quest.0000000000000025.quest_subtitle: "Physical proof. For filing purposes."
	quest.0000000000000025.title: "The First Submission"
	quest.0000000000000026.quest_desc: [
		"The Council writes:"
		""
		"\"Your submitted materials have been received, weighed, categorised, and filed in triplicate. A review committee has been convened. The committee has met."
		""
		"The conclusion is: fine."
		""
		"Please proceed to the Mechanical Press and produce the Certificate. Do not fold.\""
	]
	quest.0000000000000026.quest_subtitle: "The committee has reached a conclusion."
	quest.0000000000000026.title: "On the Matter of Certification"
	quest.0000000000000027.quest_desc: [
		"Congratulations."
		""
		"The Council acknowledges your existence."
		""
		"Keep this. You will need it later."
		"Do not lose it. The Council does not issue replacements."
		""
		"(It does issue replacements)."
	]
	quest.0000000000000027.quest_subtitle: "The Council acknowledges your existence."
	quest.0000000000000027.title: "Certificate of Minimal Competence"
	quest.0000000000000030.quest_desc: [
		"Brass is where engineering stops being a hobby and starts being industry."
		""
		"The Council approves of this transition, though it will not say so directly."
	]
	quest.0000000000000030.quest_subtitle: "Doesn't come with swords."
	quest.0000000000000030.title: "The Brass Age"
	quest.0000000000000031.quest_desc: ["It also spins."]
	quest.0000000000000031.quest_subtitle: "Maybe you'll have more luck with this type."
	quest.0000000000000031.title: "A Mixer"
	quest.0000000000000032.quest_desc: ["It picks things up. It puts things down."]
	quest.0000000000000032.quest_subtitle: "A little more real than it's invisible twin."
	quest.0000000000000032.title: "The Visible Hand of Industry"
	quest.0000000000000033.quest_desc: [
		"Electron tubes require rose quartz and iron."
		""
		"They also require patience, which the Council has decided to count as a resource for tax purposes."
	]
	quest.0000000000000033.quest_subtitle: "Patience, counted as a resource."
	quest.0000000000000033.title: "The Tube Problem"
	quest.0000000000000034.quest_desc: [
		"The Council's second submission requirement is somewhat more demanding than the first."
		""
		"The Council is aware of this."
		""
		"\"Automation,\" the review committee wrote, \"is not optional at this stage. It is the entire point.\""
	]
	quest.0000000000000034.quest_subtitle: "Automation (probably) not optional."
	quest.0000000000000034.title: "Non-Trivial Quantities"
	quest.0000000000000035.quest_desc: [
		"The Council writes:"
		""
		"\"The committee notes your submitted quantities. The committee notes, specifically, that you could not have produced these quantities by hand in any reasonable timeframe."
		""
		"The committee is not surprised. The committee is, however, making a note."
		""
		"Please proceed to the Mechanical Mixer — heated — and produce the Notice.\""
	]
	quest.0000000000000035.quest_subtitle: "The Council have noted your figures."
	quest.0000000000000035.title: "The Council Reconvenes"
	quest.0000000000000036.quest_desc: [
		"The Council has noticed you."
		""
		"Keep this. You will need it later."
		"Same rules as the Certificate."
		"The Council remains unsympathetic about lost documents."
		""
		"(Again, they do issue replacements.)"
	]
	quest.0000000000000036.quest_subtitle: "The Council has noticed you."
	quest.0000000000000036.title: "Notice of Non-Trivial Achievement"
	quest.0000000000000037.quest_desc: [
		"The Council has received field reports describing what witnesses call 'flying contraptions of concerning scale.'"
		""
		"The Council neither endorses nor discourages this."
		""
		"The Council does note, purely as an administrative observation, that resource nodes are considerably easier to supply when your vehicle does not require roads."
		""
		"Please file form AV-9(c) before any aerial incidents."
	]
	quest.0000000000000037.quest_subtitle: "An administrative observation. File form AV-9(c)."
	quest.0000000000000037.title: "The Council Notes Your Airship"
	quest.0000000000000040.quest_desc: ["The mechanical exists because some machines are simply too big to be build on your crafting table."]
	quest.0000000000000040.quest_subtitle: "Some machines want more."
	quest.0000000000000040.title: "Bigger and Better"
	quest.0000000000000041.quest_desc: [
		"You have the press. The mixer. The arm, the belt, the funnel."
		""
		"At some point, 'workshop' stops being the right word."
		""
		"The Council has a word for it."
		"They will share that word when you have earned the Writ."
	]
	quest.0000000000000041.quest_subtitle: "Workshop is no longer the right word."
	quest.0000000000000041.title: "The Full Workshop"
	quest.0000000000000042.quest_desc: [
		"The Council's final resource submission is, the committee admits, not subtle."
		""
		"Automate something. Automate several things. The Council will wait."
	]
	quest.0000000000000042.quest_subtitle: "Not very subtle"
	quest.0000000000000042.title: "Ascendancy, Quantified"
	quest.0000000000000043.quest_desc: [
		"The Guild writes:"
		""
		"\"Your figures are, and we have checked this three times, correct."
		"The stamp master has been notified. The stamp master is ready."
		"This is a significant event. The stamp master does not stamp lightly."
		""
		"Please proceed to the Mechanical Mixer — superheated — and produce the Writ."
		"The stamp is applied during crafting. We are not explaining how. It is a Guild matter.\""
		""
		"--- RECIPE ---"
		"Mix (Superheated) in a Mechanical Mixer:"
		"32x Brass Ingot + 16x Electron Tube + 8x Chromatic Compound + 4x Refined Radiance"
		"=> Writ of Industrial Ascendancy (Stamped)"
	]
	quest.0000000000000043.quest_subtitle: "The stamp master is ready."
	quest.0000000000000043.title: "On the Matter of the Stamp"
	quest.0000000000000044.quest_desc: [
		"The stamp is real."
		""
		"The Council's stamp master takes their job very seriously."
		"There are three backup stamps in case of emergency."
		"There are two now."
		""
		"Keep this. It's an important stamp, after all."
	]
	quest.0000000000000044.quest_subtitle: "The stamp is real."
	quest.0000000000000044.title: "Writ of Industrial Ascendancy (Stamped)"
	quest.0000000000000050.quest_desc: [
		"Somewhere, in the office that probably floats, three chairs sit around a mahogany table."
		""
		"The table has three empty spaces on it, each outlined faintly in ink from previous Commissions."
		""
		"The Council have been waiting."
		""
		"The Council are not going to say how long."
	]
	quest.0000000000000050.quest_subtitle: "Somewhere, in an office that probably floats."
	quest.0000000000000050.title: "The Council Awaits"
	quest.0000000000000051.quest_desc: [
		"The Council does not shake hands. The Council does not give speeches."
		"The Council does not, &munder any circumstances&r, cry at ceremonies."
		""
		"The Council presents the Insignia, stamps the record, and returns to its work."
		""
		"You are, as of this moment, the only active holder of the Master's Insignia of the Council of the Grand Firebird."
		""
		"What you do with that is entirely your own business."
		"The Council suspects it will involve another airship."
		""
		"The Council is happy with this."
	]
	quest.0000000000000051.quest_subtitle: "Present your credentials."
	quest.0000000000000051.title: "The Grand Commission"
	quest.0000000000000052.quest_desc: [
		"The Council have received eighteen reports describing what witnesses call 'drawing glowing shapes in the air near the workshop.'"
		""
		"The Council's official position is that this is an advanced surveying technique and everyone should remain calm."
		""
		"The Council's unofficial position is that this is extremely interesting, and someone around here should look into it."
	]
	quest.0000000000000052.quest_subtitle: "The Council is officially (un)concerned."
	quest.0000000000000052.title: "Field Report: Anomalous Geometry"
	quest.0228D7DD7A7E31C4.quest_desc: [
		"By now, you likely have taken noticed the increasing submission requirements to the Council. Luckily, the ingenious engineers at the Council have devised a new \"Extractor\", and have graciously provided you with the recipe."
		""
		"Hopefully, you were fortunate enough to have encountered a rare, immovable ore \"Node\" in your travels. With the new extractor and a bit of power, you can tap into a slow but steady stream of resources. How you process these resources though will be up to you..."
	]
	quest.0228D7DD7A7E31C4.quest_subtitle: "The Factory must grow."
	quest.0228D7DD7A7E31C4.title: "Extracting It."
	quest.02C8D9CEDBCDF75C.quest_desc: [
		"* Slight overall decrease in vanilla ore generation"
		""
		"* In exchange, addition of massive ore deposits"
		"  - Identifiable on the surface with flower circle indicators"
		""
		"* Most vanilla and Create ore veins/deposits can contain renewable \"ore nodes\""
		""
		"* Vanilla ore generation heights should be the same."
	]
	quest.02C8D9CEDBCDF75C.quest_subtitle: "v1.0"
	quest.03678CDF690FC78D.quest_desc: [
		"* Chance of generating iron nugget from gravel washing decreased from 12% -> 1%"
		" - The emphasis of this modpack is on the logistics and transporation of ore nods to your various, distributed factories"
		" - The idea here is to push players away from typical create farm setups and more towards transporation"
	]
	quest.03678CDF690FC78D.quest_subtitle: "v1.0"
	quest.1BF02DDA23D962A5.quest_desc: [
		"\"To all Commission Hopefuls,"
		""
		"New geological analysis is indicating the presence of supermassive ore deposits scattered across the Overworld."
		""
		"The Council is suggesting to all of you on priotizing the development of these rare deposits, which have been seen to correlate with the strange formation of flower circles. Perhaps new methods of scouting are in order.\""
	]
	quest.1BF02DDA23D962A5.quest_subtitle: "From the Council Geologists"
	quest.24704CA8ED7FA30D.quest_desc: [
		"* Ore distribtutions have been modified using the mod Large Ore Deposits."
		"  - You will probably notice sparser but larger ore deposit. The hope here was to encourage more thoughtful excavation with Create, alongside Create ReAutomated."
		""
		"* You will notice a number of client-side changes, that you may prefer to edit or disable:"
		"  - Main Menu: FancyMenu (Note that disabling this may clutter the menus)"
		"  - Audio: Sound Physics Remastered, Presence Footsteps, and Ambient Sounds"
		"  - Check the Resource Packs if you'd like to revert to vanilla UI."
	]
	quest.24704CA8ED7FA30D.quest_subtitle: "v1.0"
	quest.24704CA8ED7FA30D.title: "What's Changed (From Vanilla)"
	quest.36BA2EC7B6150AB7.quest_desc: [
		""
		"Removed Biomes:"
		""
		"* Terralith:"
		"  - terralith:cold_shrubland"
		"  - terralith:ice_marsh"
		"  - terralith:shrubland"
		""
		"* Oh The Biomes We've Gone"
		"  - windswept_desert"
		"  - amaranth_grassland"
		"  - enchanted_tangle"
		"  - dead_sea"
		"  - eroded_borealis"
		"  - jacaranda_jungle"
		"  - sierra_badlands"
		"  - shattered_glacier"
		"  - basalt_barrera"
		"  - crimson_tundra"
		"  - skyris_vale"
	]
	quest.36BA2EC7B6150AB7.quest_subtitle: "v1.0"
	task.1E9D6B1E3706B1C2.title: "What's Changed (Ore Generation)"
	task.202CEA7F38134ED3.title: "Aerial Surveillance"
	task.4D575176A7D35B0E.title: "What's Changed"
	task.67AFCAC0E6D7A69F.title: "What's Changed (From Create)"
	task.6896D10810B528EC.title: "What's Changed (Biomes)"
}
